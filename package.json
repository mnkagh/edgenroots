{
  "name": "edgenroots-formula-engine",
  "version": "1.0.0",
  "description": "Versioned, insert-only formula engine with dependency resolution and explanations.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:all": "node --test \"test/**/*.test.js\"",
    "acceptance": "node test/acceptance/run.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "formula-interpreter": "^2.1.0",
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "license": "MIT"
}
